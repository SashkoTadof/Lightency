#include <windows.h>

1 VERSIONINFO
 FILEVERSION 1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SashkoTadof"
            VALUE "FileDescription", "Lightency Explorer taskbar extension"
            VALUE "FileVersion", "1.0.1"
            VALUE "InternalName", "lightency_hook"
            VALUE "OriginalFilename", "lightency_hook.dll"
            VALUE "ProductName", "Lightency"
            VALUE "ProductVersion", "1.0.1"
            VALUE "LegalCopyright", "Copyright (C) 2026 Lightency contributors"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
